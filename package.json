{
  "name": "gomez-garmin-g5",
  "version": "0.2.0",
  "description": "Garmin G5 Enhanced avionics for MSFS 2024",
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs --watch",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/",
    "check": "npm run format && npm run lint && npm run build",
    "prepare": "husky"
  },
  "author": "Jan Gamec",
  "license": "MIT",
  "devDependencies": {
    "@microsoft/msfs-garminsdk": "^2.3.4",
    "@microsoft/msfs-sdk": "^2.3.3",
    "@microsoft/msfs-types": "^1.14.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.2.17",
    "husky": "^9.1.7",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0"
  }
}
